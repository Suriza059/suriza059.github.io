---
import BaseLayout from '../layouts/BaseLayout.astro';
import StructuredData from '../components/StructuredData.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
import { SITE } from '../consts';
import { formatDate, t } from '../i18n';

const works = (await getCollection('works'))
  .sort((a, b) => {
    const byDate = b.data.publishDate.getTime() - a.data.publishDate.getTime();
    return byDate || (a.data.order ?? 999) - (b.data.order ?? 999);
  })
  .slice(0, 3);

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);

const site = Astro.site ?? new URL(Astro.url.origin);
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: SITE.description,
  url: new URL(withBase('/'), site).href,
};
---

<BaseLayout description={SITE.description}>
  <StructuredData slot="head" schema={websiteSchema} />
  <section class="hero section">
  <p class="eyebrow">Portfolio / writing / systems notes</p>
  <h1>La formacion de una ingeniera.</h1>
  <img
    src={withBase('/profile.jpg')}
    alt="Foto de Susan"
    class="profile-photo"
  />
  <p class="lead">
    Soy Susan Uriza, estudiante de la Universidad El Bosque. En este portafolio encontrarás diversas actividades que me 
ayudarán a enriquecer mis conocimientos.
  </p>
  <div class="action-row" aria-label={t('home.primaryLinks')}>
    <a class="button" href={withBase('/works/')}>{t('home.viewWorks')}</a>
    <a class="text-link" href={withBase('/blog/')}>{t('home.readNotes')}</a>
  </div>
</section>
  <section class="section split-overview" aria-label="Sobre mí">
  <div class="video-frame">
    <p class="eyebrow">About me</p>
    <div class="video-wrapper">
      <iframe
  src="https://www.youtube.com/embed/GL2d_N9V-mM"
  title="Video de presentación"
  frameborder="0"
  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
  allowfullscreen
></iframe>
    </div>
  </div>
  <div class="feature-list">
    <article>
      <h3>Quién soy</h3>
      <p>Estudiante de la Universidad El Bosque, 
      apasionada por el desarrollo de software y la ingeniería de sistemas.</p>
    </article>
    <article>
      <h3>Qué hago</h3>
      <p>Estudio y me esfuerzo cada dia para poder superarme a mi misma.</p>
    </article>
    <article>
      <h3>Qué busco</h3>
      <p>Busco seguir creciendo como ingeniera, aplicando lo aprendido en proyectos reales y 
      en mi vida diaria poder desarrollar la tecnología para ayudar al otro.</p>
    </article>
  </div>
</section>

  <section class="section index-feed" aria-labelledby="mis-hobbies">
  <div class="section-heading">
    <p class="eyebrow">Fuera del código</p>
    <h2 id="mis-hobbies">Pasatiempos.</h2>
  </div>

  <div class="highlight-grid">
  <article class="highlight-card">
    <img src={withBase('/hobbies/hobby1.jpg')} alt="Cancha de squash" width="720" height="480" loading="lazy" />
    <div>
      <h3>Squash</h3>
      <p>Uno de mis deportes favoritos para despejar la mente fuera del código.</p>
    </div>
  </article>
  <article class="highlight-card">
    <img src={withBase('/hobbies/hobby2.jpg')} alt="Foto de Susan" width="720" height="480" loading="lazy" />
    <div>
      <h3>Sobre mí</h3>
      <p>Así soy yo, fuera de la pantalla y los proyectos.</p>
    </div>
  </article>
  <article class="highlight-card">
    <img src={withBase('/hobbies/hobby3.jpg')} alt="Trabajando en un proyecto de programación" width="720" height="480" loading="lazy" />
    <div>
      <h3>Programación</h3>
      <p>Me apasiona crear y aprender cosas nuevas a través del código.</p>
    </div>
  </article>
</div>
</section>

  <section class="section index-feed" aria-labelledby="notas-trabajos">
  <div class="section-heading">
    <p class="eyebrow">Notas y trabajos</p>
    <h2 id="notas-trabajos">Notas y trabajos mas relevantes.</h2>
    <a class="text-link" href={withBase('/blog/')}>{t('home.allPosts')}</a>
  </div>
</section>
</BaseLayout>
